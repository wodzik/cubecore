{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "web-bluetooth"
    ],
    "baseUrl": ".",
    "paths": {
      "smartcube-web-bluetooth": [
        "packages/bluetooth/node_modules/smartcube-web-bluetooth/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src"
  ]
}
